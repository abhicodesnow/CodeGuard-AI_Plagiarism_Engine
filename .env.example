# .env.example
# Copy to .env and fill in real values. Never commit .env.
# — Kafka —
KAFKA_BROKERS=kafka:9092

# — Redis —
REDIS_HOST=redis
REDIS_PORT=6379

# — MinIO —
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=codeguard
MINIO_SECRET_KEY=codeguard-secret
MINIO_USE_SSL=false
MINIO_BUCKET_SUBMISSIONS=codeguard-submissions
MINIO_BUCKET_REPORTS=codeguard-reports

# — API Gateway —
API_PORT=4000
API_MAX_UPLOAD_SIZE_MB=500
DEFAULT_SIMILARITY_THRESHOLD=0.75

# — Frontend —
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4000/graphql

# — AI Worker —
OPENAI_API_KEY=insert_your_actual_api_key_here
LLM_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
LLM_MAX_CONCURRENT=5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
LLM_MAX_SOURCE_CHARS=3000

# — Hash Worker —
WINNOW_K=8
WINNOW_W=6
MAX_FILE_SIZE_BYTES=512000
KAFKA_INPUT_TOPIC=submissions
KAFKA_SUSPICIOUS_PAIRS_TOPIC=suspicious-pairs
KAFKA_RESULTS_TOPIC=forensic-results
KAFKA_DLQ_TOPIC=dead-letter

# — Observability —
LOG_LEVEL=info